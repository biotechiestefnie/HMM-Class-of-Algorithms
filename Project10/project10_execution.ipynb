Modify Baum-Welch with a Wrapper Function to Implement Multi-Sequence EM
def baumwelch_multi(self, observations, n_iter=25):
    """
    Multi-sequence Baum-Welch training to train on 3 observations, refining probabilities through each iteration
    observations: list of strings (each validated observation sequence)
    """

    # validate all observations
    observations = [self.validate_observation(obs) for obs in observations]

    states = list(self.states)
    symbols = sorted(self.valid_chars)
    num_states = len(states)

    for _ in range(n_iter):

        # accumulate expected counts across all sequences
        total_log_gamma = None
        total_log_xi = None

        for obs in observations:
            T = len(obs)

            # forward/backward for this sequence
            fwd, _ = self.forward_algorithm(obs)
            bwd = self.backward_algorithm(obs)

            # compute log-gamma for this sequence
            log_gamma = np.zeros((num_states, T), dtype=np.float64)
            for t in range(T):
                log_norm_t = np.logaddexp.reduce(fwd[:, t] + bwd[:, t])
                for i in range(num_states):
                    log_gamma[i, t] = fwd[i, t] + bwd[i, t] - log_norm_t

            # compute log-xi for this sequence
            log_xi = np.zeros((num_states, num_states, T - 1), dtype=np.float64)
            for t in range(T - 1):
                next_char = obs[t + 1]
                emit_next = np.array([self.emit_matrix[si, next_char] for si in states])

                for i, si in enumerate(states):
                    for j, sj in enumerate(states):
                        log_xi[i, j, t] = (
                            fwd[i, t]
                            + self.trans_matrix[si, sj]
                            + emit_next[j]
                            + bwd[j, t + 1]
                        )

                log_norm_t = np.logaddexp.reduce(log_xi[:, :, t].ravel())
                log_xi[:, :, t] -= log_norm_t

            # accumulate counts
            if total_log_gamma is None:
                total_log_gamma = log_gamma
                total_log_xi = log_xi
            else:
                # logaddexp for accumulation
                total_log_gamma = np.logaddexp(total_log_gamma, log_gamma)
                total_log_xi = np.logaddexp(total_log_xi, log_xi)

        # M-step: update initial probabilities
        new_initial_probs = {}
        log_gamma_t0 = total_log_gamma[:, 0]
        log_norm = np.logaddexp.reduce(log_gamma_t0)
        for i, si in enumerate(states):
            val = log_gamma_t0[i] - log_norm
            if np.isneginf(val):
                val = np.log(1e-12)
            new_initial_probs[si] = float(np.exp(val))

        # M-step: update transition probabilities
        new_transition_probs = {}
        for i, si in enumerate(states):
            new_transition_probs[si] = {}
            log_denom = np.logaddexp.reduce(total_log_gamma[i, :-1])

            for j, sj in enumerate(states):
                log_numer = np.logaddexp.reduce(total_log_xi[i, j, :])
                if np.isneginf(log_numer):
                    log_numer = np.log(1e-12)
                new_transition_probs[si][sj] = float(np.exp(log_numer - log_denom))

        # M-step: update emission probabilities
        new_emission_probs = {}
        for i, si in enumerate(states):
            new_emission_probs[si] = {}
            log_denom = np.logaddexp.reduce(total_log_gamma[i, :])

            for sym in symbols:
                mask = []
                for obs in observations:
                    mask.extend([t for t in range(len(obs)) if obs[t] == sym])

                if mask:
                    log_numer = np.logaddexp.reduce(total_log_gamma[i, mask])
                else:
                    log_numer = np.log(1e-12)

                new_emission_probs[si][sym] = float(np.exp(log_numer - log_denom))

        # update model parameters
        self.initial_probs = new_initial_probs
        self.transition_probs = new_transition_probs
        self.emission_probs = new_emission_probs
        self.trans_matrix = StrMatrix(self.transition_probs)
        self.emit_matrix = StrMatrix(self.emission_probs)

    return new_initial_probs, new_transition_probs, new_emission_probs
